# Vercel: Project → Settings → Environment Variables
# Public vars must be prefixed with NEXT_PUBLIC_

# Django API (include /api/v1)
NEXT_PUBLIC_API_URL=https://your-backend.vercel.app/api/v1

# Tranzila webhooks must hit a public URL (usually same host as API)
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://your-backend.vercel.app/api/v1
